{
  "type": "object",
  "required": ["storyLog", "partyKnowledge", "pgUpdates", "npcUpdates", "elapsedMinutes"],
  "additionalProperties": false,
  "properties": {
    "storyLog": {
      "type": "array",
      "items": { "type": "string" }
    },
    "partyKnowledge": {
      "type": "array",
      "items": { "type": "string" }
    },
    "pgUpdates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["playerName", "handlers"],
        "additionalProperties": false,
        "properties": {
          "playerName": { "type": "string" },
          "stato": { "type": "string" },
          "position": { "type": "string" },
          "handlers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "name"],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["npc", "object", "clue"]
                },
                "name": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "npcUpdates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["npcName", "addInformazioniRivelate"],
        "additionalProperties": false,
        "properties": {
          "npcName": { "type": "string" },
          "addInformazioniRivelate": {
            "type": "array",
            "items": { "type": "string" }
          },
          "atteggiamento_verso_pg": { "type": "string" },
          "note_npc_master": { "type": "string" }
        }
      }
    },
    "elapsedMinutes": {
      "type": "number"
    }
  }
}
